<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK style (was the 2021 old-style project): the same assembly name and target. The 2021 files (NDS_2015.cs,
       MaterialProperties.cs) still build; the 2018 NDS lives in NDS2018\ (namespace NDS_WoodLibrary.NDS2018). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NDS_WoodLibrary</RootNamespace>
    <AssemblyName>NDS_WoodLibrary</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- the console driver and the tests are their own projects -->
    <Compile Remove="NDSLibraryConsoleDriver\**" />
    <Compile Remove="NDS_WoodLibrary.Tests\**" />
    <None Remove="NDSLibraryConsoleDriver\**" />
    <None Remove="NDS_WoodLibrary.Tests\**" />
  </ItemGroup>

</Project>
